      "int linearSearch(int arr[], int n, int target) {",
      "  for (int i = 0; i < n; i++) {",
      "    if (arr[i] == target) {",
      "      return i;",
      "    }",
      "  }",
      "  return -1;",
      "}",
      "",
      "int useMe() {",
