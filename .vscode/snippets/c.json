  "Radix sort with sort type": {
    "prefix": "radix_sort",
    "body": [
      "",
      "void countingSort(int arr[], int n, int exp) {",
      "  int output[n];",
      "  int count[10] = {0};",
      "",
      "  for (int i = 0; i < n; i++) {",
      "    count[(arr[i] / exp) % 10]++;",
      "  }",
      "",
      "  for (int i = 1; i < 10; i++) {",
      "    count[i] += count[i - 1];",
      "  }",
      "",
      "  for (int i = n - 1; i >= 0; i--) {",
      "    output[count[(arr[i] / exp) % 10] - 1] = arr[i];",
      "    count[(arr[i] / exp) % 10]--;",
      "  }",
      "",
      "  for (int i = 0; i < n; i++) {",
      "    arr[i] = output[i];",
      "  }",
      "}",
      "",
      "void radixSort(int arr[], int n) {",
      "  int maxVal = arr[0];",
      "  for (int i = 1; i < n; i++) {",
      "    if (arr[i] > maxVal) {",
      "      maxVal = arr[i];",
      "    }",
      "  }",
      "",
      "  for (int exp = 1; maxVal / exp > 0; exp *= 10) {",
      "    countingSort(arr, n, exp);",
      "  }",
      "}",
      "",
      "int useMe() {",
      "  int arr[] = {170, 45, 75, 90, 802, 24, 2, 66};",
      "  int n = sizeof(arr) / sizeof(arr[0]);",
      "  radixSort(arr, n);",
      "",
      "  printf(\"Sorted array: \\n\");",
      "  for (int i = 0; i < n; i++) {",
      "    printf(\"%d \", arr[i]);",
      "  }",
      "  return 0;",
      "}"
    ],
    "description": "Radix sort with sort type"
  },
  "Selection sort with sort type": {
    "prefix": "selection",
    "body": [
      "enum SortType { Ascending, Descending };",
      "",
      "void swap(int* a, int* b) {",
      "  int t = *a;",
      "  *a = *b;",
      "  *b = t;",
      "}",
      "",
      "void selectionSort(int arr[], int n, enum SortType sortType) {",
      "  int i, j, minIndex;",
      "  for (i = 0; i < n - 1; i++) {",
      "    minIndex = i;",
      "",
      "    for (j = i + 1; j < n; j++) {",
      "      if ((sortType == Ascending && arr[j] < arr[minIndex]) || (sortType == Descending && arr[j] > arr[minIndex])) {",
